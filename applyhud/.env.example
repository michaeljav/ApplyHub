
# =========================================
# DATABASE
# =========================================
# Cambia usuario, password y base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/seleccion_iad"

# =========================================
# FILE STORAGE
# =========================================
# Carpeta donde se guardan los documentos
UPLOAD_DIR="./uploads"

# =========================================
# BUSINESS LOGIC
# =========================================
# false = una sola postulación por persona en todo el sistema
# true  = puede aplicar a varias vacantes distintas
PERMITIR_MULTIPLES_VACANTES="false"

# =========================================
# AUTH / NEXTAUTH (IMPORTANTE)
# =========================================
# Cambiar por valores seguros
AUTH_SECRET="cambia-esto-por-un-string-largo-y-seguro"
NEXTAUTH_SECRET="cambia-esto-por-un-string-largo-y-seguro"

# URL base del frontend
NEXTAUTH_URL="http://localhost:3000"
